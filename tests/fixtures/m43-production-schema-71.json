  "policies": [
    {
      "name": "Members can read business branches",
      "roles": [
        "authenticated"
      ],
      "table": "zezms_branches",
      "using": "zezms_is_active_business_member(business_id)",
      "command": "SELECT",
      "with_check": null
    },
    {
      "name": "Members can read registered devices",
      "roles": [
        "authenticated"
      ],
      "table": "zezms_business_devices",
      "using": "zezms_is_active_business_member(business_id)",
      "command": "SELECT",
      "with_check": null
    },
    {
      "name": "Paired devices can read registered devices",
      "roles": [
        "authenticated"
      ],
      "table": "zezms_business_devices",
      "using": "(EXISTS ( SELECT 1\n   FROM (zezms_device_lifecycle l\n     JOIN zezms_device_access a ON (((a.business_id = l.business_id) AND (a.device_id = l.device_id))))\n  WHERE ((a.device_user_id = auth.uid()) AND (a.status = 'ACTIVE'::text) AND (a.revoked_at IS NULL) AND (l.lifecycle_state = 'ACTIVE'::text) AND (l.business_id = zezms_business_devices.business_id))))",
      "command": "SELECT",
      "with_check": null
    },
    {
      "name": "M5A3 owners read device access",
      "roles": [
        "authenticated"
      ],
      "table": "zezms_device_access",
      "using": "(zezms_has_business_role(business_id, ARRAY['OWNER'::text, 'ADMIN'::text]) OR (device_user_id = auth.uid()))",
      "command": "SELECT",
      "with_check": null
    },
    {
      "name": "M5A4 owners read lifecycle",
      "roles": [
        "authenticated"
      ],
      "table": "zezms_device_lifecycle",
      "using": "zezms_has_business_role(business_id, ARRAY['OWNER'::text, 'ADMIN'::text])",
      "command": "SELECT",
      "with_check": null
    },
    {
      "name": "zezms_sync_checkpoints_owner_select",
      "roles": [
        "authenticated"
      ],
      "table": "zezms_sync_checkpoints",
      "using": "(owner_id = auth.uid())",
      "command": "SELECT",
      "with_check": null
    },
    {
      "name": "M5A3 paired devices read counters",
      "roles": [
        "authenticated"
      ],
      "table": "zezms_sync_counters",
      "using": "((owner_id = auth.uid()) OR zezms_m5a3_is_active_device_for_owner(owner_id, ''::text))",
      "command": "SELECT",
      "with_check": null
    },
    {
      "name": "ZEZMS owner can read counters",
      "roles": [
        "authenticated"
      ],
      "table": "zezms_sync_counters",
      "using": "((( SELECT auth.uid() AS uid) IS NOT NULL) AND (( SELECT auth.uid() AS uid) = owner_id))",
      "command": "SELECT",
      "with_check": null
    },
    {
      "name": "M5A3 paired devices read operations",
      "roles": [
        "authenticated"
      ],
      "table": "zezms_sync_operations",
      "using": "((owner_id = auth.uid()) OR zezms_m5a3_is_active_device_for_owner(owner_id, ''::text))",
      "command": "SELECT",
      "with_check": null
    },
    {
      "name": "ZEZMS owner can read operations",
      "roles": [
        "authenticated"
      ],
      "table": "zezms_sync_operations",
      "using": "((( SELECT auth.uid() AS uid) IS NOT NULL) AND (( SELECT auth.uid() AS uid) = owner_id))",
      "command": "SELECT",
      "with_check": null
    },
    {
